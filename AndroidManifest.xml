<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hunt3r.southparktown"
    android:versionCode="131"
    android:versionName="0.18.0e">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.SPTown.NoActionBar"
        android:allowBackup="true"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CreatorActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".GameActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".JournalActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".CollectionActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".LoreActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".QuestActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".InventoryActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".PhoneActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".FictionActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

    </application>
</manifest>
